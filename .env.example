# Entra/App registration (see README "App registration").
EXCENSE_CLIENT_ID=
# Use "common" for personal Microsoft accounts or set the tenant ID / name
# of the Microsoft 365 organization (e.g. "contoso.onmicrosoft.com").
EXCENSE_TENANT=common

# Where tokens, the Radicale store and state live. In Docker this is /data.
EXCENSE_DATA_DIR=./data

# CalDAV/CardDAV server binding. Put this behind TLS (reverse proxy).
EXCENSE_HOST=0.0.0.0
EXCENSE_PORT=5232

# DAV account: the username you give DAVx5. Create the password with:
#   excense user-add <username>
EXCENSE_USERNAME=excense

# Sync loop cadence (seconds).
EXCENSE_SYNC_INTERVAL=300

# Calendar horizon for hatching events from Graph (good for page-size limits).
EXCENSE_CALENDAR_PAST_DAYS=365
EXCENSE_CALENDAR_FUTURE_DAYS=400